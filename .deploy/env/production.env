ENVIRONMENT="production"
DEPLOY_HOST_ROOT="/srv/vhosts/client.mapella.org"
STATE_DIR="${DEPLOY_HOST_ROOT}/state"
LOG_DIR="${DEPLOY_HOST_ROOT}/logs"
RELEASES_DIR="${DEPLOY_HOST_ROOT}/releases"
BUILDS_DIR="${DEPLOY_HOST_ROOT}/builds"
SHARED_DIR="${DEPLOY_HOST_ROOT}/shared"
DELIVERY_MODE="artifact"
ARTIFACT_SOURCE_PATH="${DEPLOY_BASE_ROOT}/build"
COMPOSE_ENV_FILE="${DEPLOY_PROJECT_ROOT}/compose/compose.production.yml"
RUNTIME_ENV_FILE="${SHARED_DIR}/app.production.env"
KEEP_RELEASES="5"
KEEP_BUILDS="5"
CHECKSUM_MODE="artifact-only"
HEALTHCHECK_MODE="hook"
SECURITY_MODE="runner-only"
DEPLOY_STRATEGY="inplace"
